# 只同步构建目录中的图片和字体，删除源目录已移除的同类旧文件。
cmake_path(IS_PREFIX BINARY_ROOT "${DESTINATION}" NORMALIZE inside_build)
if(NOT inside_build)
    message(FATAL_ERROR "Asset destination must be inside the build directory")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
file(GLOB old_files "${DESTINATION}/*.png" "${DESTINATION}/*.ttf")
foreach(old_file IN LISTS old_files)
    get_filename_component(name "${old_file}" NAME)
    if(NOT EXISTS "${SOURCE}/${name}")
        file(REMOVE "${old_file}")
    endif()
endforeach()
file(COPY "${SOURCE}/" DESTINATION "${DESTINATION}")
